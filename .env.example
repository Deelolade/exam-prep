# ==============================================================================
# ExamPrep.run Environment Configuration Template
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# --- Public Supabase Configuration ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# --- Public App URL ---
# Base URL for auth redirects and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-Only Supabase Secret Key (Service Role) ---
# Used for server-side trusted writes (e.g. persisting AI-generated questions).
# Found in Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# --- Transactional Email (Resend) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified sender email in Resend (e.g. onboarding@yourdomain.com)
EMAIL_FROM=no-reply@yourdomain.com

# --- AI Question Generation Service ---
# API key from OpenAI, DeepSeek, OpenRouter, Groq, etc.
AI_API_KEY=your-ai-api-key

# Optional: Base URL for OpenAI-compatible chat completions API (default: https://api.openai.com/v1)
# For DeepSeek: https://api.deepseek.com
AI_BASE_URL=https://api.openai.com/v1

# Optional: Model identifier (default: gpt-4o-mini)
# For DeepSeek: deepseek-chat
AI_MODEL=gpt-4o-mini
